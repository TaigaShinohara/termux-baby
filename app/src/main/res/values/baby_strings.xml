    <!-- Page 1: Hook -->
    <string name="baby_onboarding_p1_title">A terminal that teaches you commands as you tap</string>
    <string name="baby_onboarding_p1_body">Every card shows its real command. Tap and it runs as-is — and little by little, you learn the commands themselves.</string>

    <!-- Page 2: 3-Choice Goal Selector -->
    <string name="baby_onboarding_p2_title">What would you like to try first?</string>
    <string name="baby_onboarding_choice_1">Try Python &amp; helpful tools</string>
    <string name="baby_onboarding_choice_2">Check my files &amp; device easily</string>
    <string name="baby_onboarding_choice_3">Not sure yet — just looking around</string>
    <string name="baby_onboarding_praise_1">Great choice! Coding on your phone is super fun.</string>
    <string name="baby_onboarding_praise_2">Nice! Keeping things tidy is a great place to start.</string>
    <string name="baby_onboarding_praise_3">That\'s totally fine! Take your time and explore.</string>

    <!-- Page 3: Match Declaration -->
    <string name="baby_onboarding_p3_title">Termux Baby is made for you</string>
    <string name="baby_onboarding_match_1">Commands are never hidden: you see them before you run them, and what each part means.</string>
    <string name="baby_onboarding_match_2">See your files, storage, and network status in plain language right away.</string>
    <string name="baby_onboarding_match_3">Every card is safe to tap, so you can explore at your own pace.</string>

    <!-- Page 4: Step 1/3 -->
    <string name="baby_onboarding_p4_title">1. Pick a card</string>
    <string name="baby_onboarding_p4_body">Choose what you want to do by icon and plain words.</string>

    <!-- Page 5: Step 2/3 -->
    <string name="baby_onboarding_p5_title">2. See clear results</string>
    <string name="baby_onboarding_p5_body">Get a friendly summary instead of scary walls of text.</string>

    <!-- Page 6: Step 3/3 -->
    <string name="baby_onboarding_p6_title">3. Switch to Pro anytime</string>
    <string name="baby_onboarding_p6_body">Use the top switch whenever you want the full Termux terminal.</string>

