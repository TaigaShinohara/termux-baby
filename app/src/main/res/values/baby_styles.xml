<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Onboarding Activity Theme -->
    <style name="Theme.TermuxBaby.Onboarding" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/baby_primary</item>
        <item name="colorOnPrimary">@color/baby_on_primary</item>
        <item name="colorSurface">@color/baby_surface</item>
        <item name="colorOnSurface">@color/baby_text_primary</item>
        <item name="android:colorBackground">@color/baby_bg</item>
        <item name="android:windowBackground">@color/baby_bg</item>
        <item name="android:statusBarColor">@color/baby_bg</item>
        <item name="android:navigationBarColor">@color/baby_bg</item>
    </style>

    <!-- Bottom Sheet Dialog Theme -->
    <style name="ThemeOverlay.TermuxBaby.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.DayNight.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.Baby.BottomSheet</item>
        <item name="colorPrimary">@color/baby_primary</item>
        <item name="colorOnPrimary">@color/baby_on_primary</item>
        <item name="colorSurface">@color/baby_surface</item>
        <item name="colorOnSurface">@color/baby_text_primary</item>
    </style>

    <style name="Widget.Baby.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Baby.BottomSheet</item>
        <item name="backgroundTint">@color/baby_surface</item>
    </style>

    <style name="ShapeAppearanceOverlay.Baby.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">24dp</item>
        <item name="cornerSizeTopRight">24dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- 4-Tier Typography Hierarchy -->
    <style name="TextAppearance.Baby.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <style name="TextAppearance.Baby.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Baby.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="TextAppearance.Baby.BodySecondary" parent="TextAppearance.Baby.Body">
        <item name="android:textColor">@color/baby_text_secondary</item>
    </style>

    <style name="TextAppearance.Baby.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/baby_text_secondary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <style name="TextAppearance.Baby.Code" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Card Styles -->
    <style name="Widget.Baby.ActionCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/baby_surface</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/baby_border</item>
        <item name="rippleColor">@color/baby_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Baby.ActionCard.Highlighted" parent="Widget.Baby.ActionCard">
        <item name="strokeWidth">2dp</item>
        <item name="strokeColor">@color/baby_primary</item>
        <item name="cardBackgroundColor">@color/baby_primary_container</item>
    </style>

    <style name="Widget.Baby.ChoiceCard" parent="Widget.Baby.ActionCard">
        <item name="cardCornerRadius">18dp</item>
        <item name="strokeWidth">1.5dp</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.Baby.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="backgroundTint">@color/baby_primary</item>
        <item name="android:textColor">@color/baby_on_primary</item>
        <item name="iconTint">@color/baby_on_primary</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Widget.Baby.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">28dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="strokeColor">@color/baby_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="iconTint">@color/baby_text_primary</item>
        <item name="rippleColor">@color/baby_ripple</item>
    </style>

    <style name="Widget.Baby.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/baby_text_secondary</item>
        <item name="rippleColor">@color/baby_ripple</item>
    </style>

    <!-- Chip Style -->
    <style name="Widget.Baby.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipStrokeColor">@color/baby_border</item>
        <item name="chipBackgroundColor">@color/baby_surface_subtle</item>
        <item name="android:textColor">@color/baby_text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
