<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/onboarding_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="16dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <!-- Visual Hero Illustration / Icon -->
        <FrameLayout
            android:id="@+id/onboarding_visual_container"
            android:layout_width="148dp"
            android:layout_height="148dp"
            android:layout_marginBottom="28dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/onboarding_visual_card"
                android:layout_width="136dp"
                android:layout_height="136dp"
                android:layout_gravity="center"
                app:cardBackgroundColor="@color/baby_primary_container"
                app:cardCornerRadius="36dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/baby_border"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/onboarding_hero_icon"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    app:tint="@color/baby_primary" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

        <!-- Single-Claim Headline -->
        <TextView
            android:id="@+id/onboarding_title"
            style="@style/TextAppearance.Baby.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:gravity="center" />

        <!-- Short Supporting Line (1-2 lines max) -->
        <TextView
            android:id="@+id/onboarding_body"
            style="@style/TextAppearance.Baby.BodySecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textSize="15sp" />

        <!-- A real home card, shown on page 1: the promise ("every card
             shows its command") is demonstrated, not just described. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Baby.ActionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/baby_action_files_title"
                    android:textAppearance="@style/TextAppearance.Baby.Title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="ls -la --color=never"
                    android:textAppearance="@style/TextAppearance.Baby.Code" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/baby_action_files_sub"
                    android:textAppearance="@style/TextAppearance.Baby.Caption" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
