<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/baby_chip_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minWidth="120dp"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="14dp">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/chip_spinner"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:indeterminate="true"
        app:indicatorColor="@color/baby_primary"
        app:indicatorSize="18dp"
        app:trackThickness="2dp" />

    <ImageView
        android:id="@+id/chip_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:tint="@color/baby_primary" />

    <TextView
        android:id="@+id/chip_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:maxWidth="160dp"
        android:textColor="@color/baby_text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/chip_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:maxLines="1"
        android:textColor="@color/baby_text_secondary"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/chip_close"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/baby_session_bar_close"
        android:padding="7dp"
        android:src="@drawable/ic_baby_close"
        app:tint="@color/baby_text_secondary" />
</LinearLayout>
