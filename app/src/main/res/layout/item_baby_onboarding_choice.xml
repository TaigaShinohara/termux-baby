<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- Single Question Headline -->
        <TextView
            android:id="@+id/onboarding_choice_title"
            style="@style/TextAppearance.Baby.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:gravity="center"
            android:text="@string/baby_onboarding_p2_title" />

        <!-- Choice 1: Tools & Python -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onboarding_choice_card_1"
            style="@style/Widget.Baby.ChoiceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="68dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    app:cardBackgroundColor="@color/baby_surface_subtle"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/onboarding_choice_icon_1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/baby_primary" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/onboarding_choice_text_1"
                    style="@style/TextAppearance.Baby.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/baby_onboarding_choice_1" />

                <ImageView
                    android:id="@+id/onboarding_choice_check_1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible"
                    app:tint="@color/baby_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Choice 2: Files & Device -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onboarding_choice_card_2"
            style="@style/Widget.Baby.ChoiceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:minHeight="68dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    app:cardBackgroundColor="@color/baby_surface_subtle"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/onboarding_choice_icon_2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/baby_primary" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/onboarding_choice_text_2"
                    style="@style/TextAppearance.Baby.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/baby_onboarding_choice_2" />

                <ImageView
                    android:id="@+id/onboarding_choice_check_2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible"
                    app:tint="@color/baby_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Choice 3: Escape Hatch (Not sure yet) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onboarding_choice_card_3"
            style="@style/Widget.Baby.ChoiceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:minHeight="68dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="14dp"
                    app:cardBackgroundColor="@color/baby_surface_subtle"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/onboarding_choice_icon_3"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        app:tint="@color/baby_primary" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/onboarding_choice_text_3"
                    style="@style/TextAppearance.Baby.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/baby_onboarding_choice_3" />

                <ImageView
                    android:id="@+id/onboarding_choice_check_3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="8dp"
                    android:importantForAccessibility="no"
                    android:visibility="invisible"
                    app:tint="@color/baby_primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Encouraging Praise Reaction Banner (appears immediately on tap) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onboarding_praise_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:visibility="invisible"
            app:cardBackgroundColor="@color/baby_primary_container"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/onboarding_praise_text"
                style="@style/TextAppearance.Baby.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:gravity="center"
                android:padding="14dp"
                android:textColor="@color/baby_on_primary_container" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
