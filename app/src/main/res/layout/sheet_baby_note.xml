<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/baby_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/baby_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/baby_note_title"
            android:textAppearance="@style/TextAppearance.Baby.Headline" />

        <ImageButton
            android:id="@+id/note_close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/baby_note_close"
            android:src="@drawable/ic_baby_close"
            app:tint="@color/baby_text_secondary" />
    </LinearLayout>

    <!-- Zero-friction Note Input (No title needed) -->
    <EditText
        android:id="@+id/note_input"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/baby_input_bg"
        android:gravity="top|start"
        android:hint="@string/baby_note_hint"
        android:inputType="textMultiLine|textCapSentences"
        android:padding="14dp"
        android:textAppearance="@style/TextAppearance.Baby.Body"
        android:textColorHint="@color/baby_text_secondary" />

    <TextView
        android:id="@+id/note_feedback_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textAppearance="@style/TextAppearance.Baby.Caption"
        android:textColor="@color/baby_success"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/note_save_button"
        style="@style/Widget.Baby.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/baby_note_save"
        app:icon="@drawable/ic_baby_check"
        app:iconGravity="textStart" />

    <!-- Recent Notes Section -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/baby_note_recent_title"
        android:textAppearance="@style/TextAppearance.Baby.Title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/note_recent_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/note_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/baby_note_empty_list"
        android:textAppearance="@style/TextAppearance.Baby.BodySecondary"
        android:visibility="gone" />
</LinearLayout>
