<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/baby_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/baby_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/baby_icon_circle">

            <ImageView
                android:id="@+id/runner_action_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_baby_sparkle"
                app:tint="@color/baby_primary" />
        </FrameLayout>

        <TextView
            android:id="@+id/runner_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Baby.Title" />

        <ImageButton
            android:id="@+id/runner_close_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/baby_runner_close"
            android:src="@drawable/ic_baby_close"
            app:tint="@color/baby_text_secondary" />
    </LinearLayout>

    <!-- Status Banner / Friendly Result Area -->
    <LinearLayout
        android:id="@+id/runner_status_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/baby_code_box"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/runner_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/baby_primary"
                app:indicatorSize="24dp"
                app:trackThickness="3dp" />

            <ImageView
                android:id="@+id/runner_status_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_baby_check"
                android:visibility="gone"
                app:tint="@color/baby_success" />

            <TextView
                android:id="@+id/runner_status_headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/baby_runner_running"
                android:textAppearance="@style/TextAppearance.Baby.Title" />
        </LinearLayout>

        <TextView
            android:id="@+id/runner_summary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Baby.Body"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Optional Recovery / Install CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/runner_recovery_button"
        style="@style/Widget.Baby.PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/baby_runner_install_now"
        android:visibility="gone"
        app:icon="@drawable/ic_baby_install"
        app:iconGravity="textStart" />

    <!-- Rank B: Collapsible Raw Output Accordion (Collapsed by default) -->
    <LinearLayout
        android:id="@+id/runner_details_toggle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/runner_details_toggle_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/baby_runner_show_details"
            android:textAppearance="@style/TextAppearance.Baby.BodySecondary" />

        <ImageView
            android:id="@+id/runner_details_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_baby_chevron_down"
            app:tint="@color/baby_text_secondary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/runner_details_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/baby_code_box"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/baby_runner_command_label"
            android:textAppearance="@style/TextAppearance.Baby.Caption" />

        <TextView
            android:id="@+id/runner_command_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Baby.Code"
            android:textIsSelectable="true" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/runner_raw_output_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Baby.Code"
                android:textIsSelectable="true" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runner_open_pro_button"
            style="@style/Widget.Baby.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="6dp"
            android:text="@string/baby_runner_open_pro"
            app:icon="@drawable/ic_baby_terminal"
            app:iconTint="@color/baby_text_secondary" />
    </LinearLayout>

    <!-- Bottom Thumb-Zone Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runner_secondary_button"
            style="@style/Widget.Baby.SecondaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="@string/baby_runner_run_again"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runner_primary_button"
            style="@style/Widget.Baby.PrimaryButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/baby_runner_cancel" />
    </LinearLayout>
</LinearLayout>
