<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/baby_home_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/baby_bg"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Preparing banner: shown only while the environment is not
                 ready yet. Once ready it disappears — a permanent greeting
                 and badge would be constant noise on a shortcut surface. -->
            <LinearLayout
                android:id="@+id/baby_home_header_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/baby_home_greeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/baby_home_greeting"
                    android:textAppearance="@style/TextAppearance.Baby.Headline" />

                <LinearLayout
                    android:id="@+id/baby_home_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/baby_badge_bg"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp">

                    <ImageView
                        android:id="@+id/baby_home_status_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baby_check"
                        app:tint="@color/baby_on_primary_container" />

                    <TextView
                        android:id="@+id/baby_home_status_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/baby_home_status_ready"
                        android:textColor="@color/baby_on_primary_container"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- Pinned shortcut grid: built dynamically by
                 BabyModeController (catalog pins + user commands). -->
            <LinearLayout
                android:id="@+id/baby_action_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Next-to-learn: the curriculum's next unmastered command. -->
            <LinearLayout
                android:id="@+id/baby_next_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/baby_home_next_title"
                    android:textAppearance="@style/TextAppearance.Baby.Title" />

                <include
                    android:id="@+id/baby_next_card"
                    layout="@layout/item_baby_action_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/baby_add_custom_button"
                style="@style/Widget.Baby.SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/baby_home_add_custom"
                app:icon="@drawable/ic_baby_terminal"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Thumb-zone Primary CTA: the full command catalog -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/baby_bg"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/baby_home_find_action_button"
            style="@style/Widget.Baby.PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/baby_home_find_action_cd"
            android:text="@string/baby_home_find_action"
            app:icon="@drawable/ic_baby_search"
            app:iconGravity="textStart"
            app:iconPadding="10dp" />
    </FrameLayout>
</LinearLayout>
