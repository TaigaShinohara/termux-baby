<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/baby_surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/baby_sheet_handle" />

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/baby_helper_title"
            android:textAppearance="@style/TextAppearance.Baby.Headline" />

        <ImageButton
            android:id="@+id/helper_close_button"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/baby_runner_close"
            android:src="@drawable/ic_baby_close"
            app:tint="@color/baby_text_secondary" />
    </LinearLayout>

    <!-- Plain-Language Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/baby_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="10dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_baby_search"
            app:tint="@color/baby_text_secondary" />

        <EditText
            android:id="@+id/helper_search_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/baby_helper_search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Baby.Body"
            android:textColorHint="@color/baby_text_secondary" />
    </LinearLayout>

    <!-- Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/helper_category_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:checkedChip="@id/helper_chip_all"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/helper_chip_all"
                style="@style/Widget.Baby.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/baby_helper_cat_all" />

            <com.google.android.material.chip.Chip
                android:id="@+id/helper_chip_files"
                style="@style/Widget.Baby.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/baby_helper_cat_files" />

            <com.google.android.material.chip.Chip
                android:id="@+id/helper_chip_network"
                style="@style/Widget.Baby.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/baby_helper_cat_network" />

            <com.google.android.material.chip.Chip
                android:id="@+id/helper_chip_learn"
                style="@style/Widget.Baby.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/baby_helper_cat_learn" />

            <com.google.android.material.chip.Chip
                android:id="@+id/helper_chip_tools"
                style="@style/Widget.Baby.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/baby_helper_cat_tools" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Recipe List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/helper_recipe_list"
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/helper_empty_view"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="@string/baby_helper_empty"
        android:textAppearance="@style/TextAppearance.Baby.BodySecondary"
        android:visibility="gone" />
</LinearLayout>
